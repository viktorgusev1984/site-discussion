# Copy to .env. Generate strong values; never commit the resulting file.
POSTGRES_DB=discussions
POSTGRES_USER=discussions
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL=PT24H
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
NOTIFICATION_WORKER_INTERVAL=10s
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_INITIAL_BACKOFF=30s
NOTIFICATION_CONNECT_TIMEOUT=3s
NOTIFICATION_READ_TIMEOUT=5s
NOTIFICATION_MAX_RESPONSE_BYTES=65536
NOTIFICATION_MAX_REDIRECTS=2
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
BACKEND_PORT=8080
FRONTEND_PORT=3000
